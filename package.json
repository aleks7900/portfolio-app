{
  "name": "header-app",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npx @tailwindcss/cli -i ./src/index.css -o ./src/output.css && tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "dev:css": "npx @tailwindcss/cli -i ./src/index.css -o ./src/output.css --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@types/three": "^0.187.0",
    "animejs": "^4.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "framer-motion": "^14.12.0",
    "i18next": "^27.1.1",
    "keen-slider": "^6.8.6",
    "lucide-react": "^1.72.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-head": "^3.4.2",
    "react-i18next": "^18.0.1",
    "react-icons": "^5.7.0",
    "react-is": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.7.0",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/cli": "^4.3.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.9",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "jsdom": "^29.1.1",
    "msw": "^3.0.5",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
